<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Dispatcher.Desktop.MainWindow"
        Title="Dispatcher"
        Width="1100" Height="720" MinWidth="760" MinHeight="480">
  <Grid Classes="form" RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="12">
    <Grid.Styles>
      <!-- Uniform spacing between every control in the window -->
      <Style Selector="Grid.form > :is(Control)">
        <Setter Property="Margin" Value="4" />
      </Style>
    </Grid.Styles>

    <!-- Connection and import -->
    <Grid Grid.Row="0" Classes="form" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" Margin="0">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="PostgreSQL connection" VerticalAlignment="Center" />
      <TextBox   Grid.Row="0" Grid.Column="1" x:Name="ConnectionBox" />
      <Button    Grid.Row="0" Grid.Column="2" Content="Reload" Click="OnReload"
                 ToolTip.Tip="Read the stored data and schedule from the database" />

      <TextBlock Grid.Row="1" Grid.Column="0" Text="Intake workbook" VerticalAlignment="Center" />
      <TextBox   Grid.Row="1" Grid.Column="1" x:Name="InputBox" IsReadOnly="True"
                 Watermark="Choose an intake .xlsx (e.g. examples/mock_data.xlsx)" />
      <Button    Grid.Row="1" Grid.Column="2" Content="Browse…" Click="OnBrowseInput" />
    </Grid>

    <!-- Actions, in workflow order -->
    <WrapPanel Grid.Row="1" Orientation="Horizontal">
      <WrapPanel.Styles>
        <Style Selector="Button"><Setter Property="Margin" Value="0,0,8,8" /></Style>
      </WrapPanel.Styles>
      <Button x:Name="ImportButton" Content="1. Import into database" Click="OnImport"
              ToolTip.Tip="Replace all stored employees, skills, customers, tasks and history with the workbook" />
      <Button x:Name="DispatchButton" Content="2. Run dispatch" Classes="accent" Click="OnDispatch"
              ToolTip.Tip="Read the data from the database, assign crews and save the assignments" />
      <Button x:Name="ExportButton" Content="3. Export schedule…" Click="OnExport"
              ToolTip.Tip="Save the stored schedule as an Excel workbook" />
      <Button Content="Create intake template…" Click="OnCreateTemplate" />
      <Button Content="Save sample data…" Click="OnSaveSample" />
    </WrapPanel>

    <TextBlock Grid.Row="2" x:Name="SummaryText" FontWeight="SemiBold" />
    <TextBlock Grid.Row="3" x:Name="StatusText" TextWrapping="Wrap" />

    <!-- Schedule as stored in the database -->
    <DataGrid Grid.Row="4" x:Name="ResultsGrid" IsReadOnly="True" AutoGenerateColumns="True"
              GridLinesVisibility="Horizontal" BorderThickness="1"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" />
  </Grid>
</Window>
